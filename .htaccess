<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTP_HOST} ^oakbridge.events$ [NC,OR]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://www.oakbridge.events/$1 [NC,L,R=301]

    # Block direct web access to app source, git history and server-only folders
    # (the site root is the project root, so these would otherwise be reachable)
    RewriteRule ^(\.git|app|bootstrap|config|database|lang|node_modules|resources|routes|storage|tests)(/|$) - [F,L]
    # vendor/ is blocked except the CSS/JS folders the admin panel loads, and no PHP runs from it
    RewriteRule ^vendor/(?!(adminlte|bootstrap|fontawesome-free|icheck-bootstrap|jquery|overlayScrollbars|popper)/) - [F,L]
    RewriteRule ^vendor/.*\.php$ - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<Files ~ "\.(env|json|config.js|md|gitignore|gitattributes|lock|editorconfig|yml|styleci.yml)$">
    Order allow,deny
    Deny from all
</Files>

Options -Indexes
<Files ~ "(artisan|package.json|webpack.mix.js)$">
    Order allow,deny
    Deny from all
</Files>

# Block backups, database dumps and log files anywhere on the site
<FilesMatch "\.(sql|zip|gz|tar|rar|7z|bak|log|sh)$">
    Order allow,deny
    Deny from all
</FilesMatch>
